{
  "manifest_version": 3,
  "name": "Social Media Video Downloader Pro (Douyin, TikTok, IG, X, YouTube, FB, Threads)",
  "version": "2.1.0",
  "description": "Quét toàn bộ video/ảnh từ Douyin, TikTok, Instagram, X (Twitter), YouTube, Facebook và Threads. Tải hàng loạt không watermark trực tiếp vào thư mục máy tính.",
  "permissions": [
    "sidePanel",
    "storage",
    "declarativeNetRequest",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.douyin.com/*",
    "*://*.tiktok.com/*",
    "*://*.douyinvod.com/*",
    "*://*.amemv.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.byteoversea.com/*",
    "*://*.ibyteimg.com/*",
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.twimg.com/*",
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.ytimg.com/*",
    "*://*.facebook.com/*",
    "*://*.threads.net/*",
    "*://*.fbsbx.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules/dnr-rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Mở Video Downloader Panel"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.douyin.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.threads.net/*"
      ],
      "js": ["src/content-scripts/main-interceptor.iife.ts"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.douyin.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.threads.net/*"
      ],
      "js": ["src/content-scripts/isolated-bridge.iife.ts"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
